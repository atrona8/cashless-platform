{
  "name": "cashless-platform",
  "private": true,
  "description": "Système cashless multi-tenant — monorepo (SPECIFICATION §2.1)",
  "workspaces": [
    "apps/api",
    "packages/contracts",
    "packages/ledger-sql",
    "packages/tag-format"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "generate": "npm run generate -w @cashless/contracts",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
