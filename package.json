{
  "name": "cashless-platform",
  "private": true,
  "description": "Système cashless multi-tenant — monorepo (SPECIFICATION §2.1)",
  "workspaces": [
    "apps/api",
    "packages/contracts",
    "packages/ledger-sql",
    "packages/tag-format"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "generate": "npm run generate -w @cashless/contracts",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "@peculiar/asn1-android": "2.10.0",
    "@peculiar/asn1-asym-key": "2.10.0",
    "@peculiar/asn1-cms": "2.10.0",
    "@peculiar/asn1-csr": "2.10.0",
    "@peculiar/asn1-ecc": "2.10.0",
    "@peculiar/asn1-pfx": "2.10.0",
    "@peculiar/asn1-pkcs8": "2.10.0",
    "@peculiar/asn1-pkcs9": "2.10.0",
    "@peculiar/asn1-rsa": "2.10.0",
    "@peculiar/asn1-schema": "2.10.0",
    "@peculiar/asn1-x509": "2.10.0",
    "@peculiar/asn1-x509-attr": "2.10.0",
    "@peculiar/asn1-x509-post-quantum": "2.10.0",
    "@peculiar/utils": "2.0.3",
    "asn1js": "3.0.10",
    "tsyringe": "4.10.0"
  }
}
