{
  "name": "@cashless/api",
  "version": "0.0.0",
  "private": true,
  "description": "API centrale NestJS : moteur d'écritures, garanties transverses (SPECIFICATION §2, §5, §10)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --require tsx/cjs dist/main.js",
    "start:edge": "node --require tsx/cjs dist/main.edge.js",
    "start:tag-keys": "node --require tsx/cjs dist/main.tag-keys.js",
    "start:personalization": "node --require tsx/cjs dist/main.personalization.js",
    "start:tag-check": "node --require tsx/cjs dist/main.tag-check.js",
    "start:psp-poller": "node --require tsx/cjs dist/main.psp-poller.js",
    "start:maintenance": "node --require tsx/cjs dist/main.maintenance.js",
    "start:snapshot-signer": "node --require tsx/cjs dist/main.snapshot-signer.js",
    "start:key-admin": "node --require tsx/cjs dist/main.key-admin.js",
    "start:snapshot-content": "node --require tsx/cjs dist/main.snapshot-content.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@cashless/shared-rules": "0.0.0",
    "@cashless/tag-format": "0.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@peculiar/asn1-android": "2.10.0",
    "@peculiar/asn1-schema": "2.10.0",
    "@peculiar/asn1-x509": "2.10.0",
    "@peculiar/x509": "2.1.0",
    "argon2": "0.44.0",
    "canonicalize": "5.1.0",
    "cbor2": "2.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "structured-headers": "2.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
