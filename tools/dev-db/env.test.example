# Copier en `.env.test` à la racine (non commité) si les valeurs par défaut de tools/dev-db/env.sh ne conviennent pas.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=cashless_test
CASHLESS_APP_PASSWORD=cashless_app_local
DATABASE_URL_OWNER=postgres://postgres@127.0.0.1:5433/cashless_test
DATABASE_URL_APP=postgres://cashless_app:cashless_app_local@127.0.0.1:5433/cashless_test
# Rôles des processus des clés de bracelet (mission bracelets-nfc) ; valeurs par défaut de tools/dev-db/env.sh.
CASHLESS_TAGKEYS_PASSWORD=cashless_tagkeys_local
CASHLESS_PERSO_PASSWORD=cashless_perso_local
CASHLESS_TAGCHECK_PASSWORD=cashless_tagcheck_local
CASHLESS_KEYADMIN_PASSWORD=cashless_keyadmin_local
DATABASE_URL_TAGKEYS=postgres://cashless_tagkeys:cashless_tagkeys_local@127.0.0.1:5433/cashless_test
DATABASE_URL_PERSO=postgres://cashless_perso:cashless_perso_local@127.0.0.1:5433/cashless_test
DATABASE_URL_TAGCHECK=postgres://cashless_tagcheck:cashless_tagcheck_local@127.0.0.1:5433/cashless_test
DATABASE_URL_KEYADMIN=postgres://cashless_keyadmin:cashless_keyadmin_local@127.0.0.1:5433/cashless_test
# Mission identite-enrolement-terminaux : valeurs de test (publiques) ; refusées en production.
IDEMPOTENCY_HMAC_KEY=636173686c6573732d6964656d706f74656e63792d686d61632d6b65792d64652d746573742d756e697175656d656e742d3030
ENROLLMENT_CODE_HMAC_KEY=636173686c6573732d656e726f6c6c6d656e742d636f64652d686d61632d6b65792d64652d746573742d756e697175656d656e74
DEVICE_TOKEN_ISSUER=https://api.cashless.test
DEVICE_TOKEN_TTL_SECONDS=900
DEVICE_REFRESH_TOKEN_TTL_DAYS=30
DEVICE_CERT_VALIDITY_DAYS=365
CLOCK_TOLERANCE_SECONDS=120
IOS_APP_ATTEST_ENVIRONMENT=development
# Racines d'attestation (R-05, R-06 ; lot WP14) : fichiers PEM, obligatoires en production,
# absents ici.
# - ANDROID_ATTESTATION_ROOTS : TOUTES les racines que Google publie pour l'attestation de clé
#   (developer.android.com/privacy-and-security/security-key-attestation, « Root certificates » ;
#   liste JSON : https://android.googleapis.com/attestation/root), soit l'ancienne racine RSA
#   4096 bits et la ou les nouvelles racines de la rotation annoncée par Google, tant que des
#   appareils sont attestés par l'une ou l'autre. Au déploiement, chaque empreinte SHA-256 est
#   comparée à la publication de Google (jamais recopiée d'un autre dépôt) ; à revoir à chaque
#   annonce de rotation. Liste de révocation : https://android.googleapis.com/attestation/status.
# - IOS_APP_ATTEST_ROOT : « Apple App Attestation Root CA » (www.apple.com/certificateauthority).
# Sans ANDROID_ATTESTATION_ROOTS (hors production seulement) : faux vérificateur, refusé en
# production ; une racine de test (sujet marqué cashless-test-attestation-root) y est refusée aussi.
# TLS_CERT_FILE, TLS_KEY_FILE, DEVICE_CA_CERT_FILE, DEVICE_CA_FAKE_KEY_FILE : posés par les tests HTTPS
# (apps/api/test/support/tls.ts), certificats générés à l'exécution.
