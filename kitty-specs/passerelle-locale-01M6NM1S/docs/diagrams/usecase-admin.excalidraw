   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Bascule demandée par un admin, avec le lien, jamais prise par la passerelle (décision du 05/11/2026). Inscription par une personne : alerte immédiate, délai de 30 min avant les mots de passe.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "Bascule demandée par un admin, avec le lien, jamais prise par la passerelle (décision du 05/11/2026). Inscription par une personne : alerte immédiate, délai de 30 min avant les mots de passe.",
   "lineHeight": 1.25,
   "baseline": 20
  },
  {
   "id": "text-42",
   "type": "text",
