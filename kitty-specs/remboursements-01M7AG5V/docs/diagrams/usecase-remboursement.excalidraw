   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Planifié (plan du 13/11/2026), non implémenté. Le valideur est une autre personne que l’auteur et que le demandeur. Le paiement Wave ou Orange Money est fait hors système.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "Planifié (plan du 13/11/2026), non implémenté. Le valideur est une autre personne que l’auteur et que le demandeur. Le paiement Wave ou Orange Money est fait hors système.",
   "lineHeight": 1.25,
   "baseline": 20
  },
