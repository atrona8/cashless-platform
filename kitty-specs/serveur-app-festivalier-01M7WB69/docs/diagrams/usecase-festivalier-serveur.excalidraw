   "versionNonce": 42,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Après rotation, les anciens codes sont refusés comme inconnus ; les nouveaux sont réémis par la commande d’exploitation, dont le fichier nomme chaque bracelet.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
