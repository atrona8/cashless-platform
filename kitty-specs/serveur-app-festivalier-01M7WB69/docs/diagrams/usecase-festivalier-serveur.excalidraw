   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "L’identification exige un compte au numéro vérifié ; la révocation se fait à deux personnes.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "L’identification exige un compte au numéro vérifié ; la révocation se fait à deux personnes.",
   "lineHeight": 1.25,
